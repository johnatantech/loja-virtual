{
  "name": "Loja Virtual (.NET 10 + Angular + PostgreSQL)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "memory": "8gb" },
  "containerEnv": { "NG_CLI_ANALYTICS": "false" },
  "forwardPorts": [4200, 5120],
  "portsAttributes": {
    "4200": { "label": "Loja (Angular)", "onAutoForward": "openBrowser" },
    "5120": { "label": "API (.NET)" },
    "5432": { "label": "PostgreSQL", "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash scripts/setup-dev.sh",
  "postStartCommand": "docker compose up -d db",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "angular.ng-template",
        "ms-azuretools.vscode-containers",
        "editorconfig.editorconfig"
      ]
    }
  }
}
